class Solution {
public:
    void swp(int& a, int &b){
        a = a ^ b;
        b = a ^ b;
        a = a ^ b;
    }
    vector<vector<int>> reverseSubmatrix(vector<vector<int>>& grid, int x, int y, int k) {
        int m = grid.size(), n = grid[0].size();
        int p = 1;
        for(int i = x; i < x + k/2; ++i){
            for(int j = y; j < y + k; ++j){
                swp(grid[i][j], grid[i + k - p][j]);
            }
            p += 2;
        }
        return grid;
    }
};
